# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets.

PORT=5000
NODE_ENV=development

# Must match the credentials in the root .env used by docker-compose,
# and DB_PORT must match POSTGRES_PORT there too.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dartn_db
DB_USER=dartn_admin
DB_PASSWORD=change_me_locally

# Python AI microservice
AI_SERVICE_URL=http://127.0.0.1:8000

# Authentication - generate a real one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
