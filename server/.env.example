# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets.

PORT=5000
NODE_ENV=development

# Must match the credentials in the root .env used by docker-compose,
# and DB_PORT must match POSTGRES_PORT there too.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dartn_db
DB_USER=dartn_admin
DB_PASSWORD=change_me_locally
